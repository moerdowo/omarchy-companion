#!/usr/bin/env bash
# Build or verify the reproducible artwork-source asset shipped with a release.

set -euo pipefail

usage() {
  cat <<'USAGE'
Usage:
  tools/build-source-archive [output.tar.gz]
  tools/build-source-archive --check archive.tar.gz

Builds the eight-file grokchief-artwork-sources.tar.gz release asset. The
default output is ${TMPDIR:-/tmp}/grokchief-artwork-sources.tar.gz. --check
rebuilds the archive and requires it to match byte for byte.
USAGE
}

repo=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
archive_name=grokchief-artwork-sources.tar.gz
members=(
  tools/source/NOTICE
  tools/source/README.md
  tools/source/gritty-blink.png
  tools/source/gritty-faces.png
  tools/source/gritty-faces12.png
  tools/source/gritty-front.png
  tools/source/gritty-tongue.png
  tools/source/quattro.png
)

mode=build
case ${1:-} in
  -h|--help)
    usage
    exit 0
    ;;
  --check)
    mode=check
    shift
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }

if [[ $mode == check ]]; then
  output=$1
else
  output=${1:-${TMPDIR:-/tmp}/$archive_name}
fi
[[ $output == /* ]] || output=$PWD/$output

for member in "${members[@]}"; do
  [[ -f $repo/$member && ! -L $repo/$member ]] || {
    echo "build-source-archive: missing regular source: $member" >&2
    exit 1
  }
done

epoch=${SOURCE_DATE_EPOCH:-}
if [[ -z $epoch ]]; then
  epoch=$(git -C "$repo" log -1 --format=%ct HEAD -- manifest.json tools/source/README.md tools/source/NOTICE)
fi
[[ $epoch =~ ^[0-9]+$ ]] || {
  echo "build-source-archive: set SOURCE_DATE_EPOCH to a Unix timestamp" >&2
  exit 1
}

expected=$(printf '%s\n' "${members[@]}")
temporary=
cleanup() { [[ -z $temporary ]] || rm -f -- "$temporary"; }
trap cleanup EXIT

build() {
  local destination=$1
  tar --create --file=- --format=ustar --no-recursion \
    --owner=0 --group=0 --numeric-owner --mode='u=rw,go=r' \
    --mtime="@$epoch" --sort=name --directory="$repo" \
    "${members[@]}" | gzip --no-name --best > "$destination"

  gzip --test "$destination"
  local actual
  actual=$(tar --list --gzip --file="$destination")
  [[ $actual == "$expected" ]] || {
    echo "build-source-archive: archive member list changed" >&2
    return 1
  }
}

if [[ $mode == check ]]; then
  [[ -f $output ]] || {
    echo "build-source-archive: archive does not exist: $output" >&2
    exit 1
  }
  temporary=$(mktemp "${TMPDIR:-/tmp}/grokchief-artwork-check.XXXXXX.tar.gz")
  build "$temporary"
  cmp --silent -- "$temporary" "$output" || {
    echo "build-source-archive: archive does not match the audited sources and epoch" >&2
    exit 1
  }
  printf 'build-source-archive: reproducible: '
  sha256sum "$output"
  exit 0
fi

mkdir -p -- "$(dirname "$output")"
temporary=$(mktemp "${output}.tmp.XXXXXX")
build "$temporary"
mv -f -- "$temporary" "$output"
temporary=
printf 'build-source-archive: built: '
sha256sum "$output"
