#!/usr/bin/env bash
# Draws the README and documentation images from the character itself.
#
# The pictures a repository shows are the first thing anyone checks it against,
# so they are generated by the code that ships rather than captured once and
# left to drift: this walks keystone/Bloub.js exactly as the shell does, writes
# SVG, and rasterises it. Re-run it whenever the character changes.
#
# Needs Node 18+ and rsvg-convert (ImageMagick's own SVG delegate).
set -euo pipefail

here="$(cd "$(dirname "$0")/.." && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

command -v rsvg-convert >/dev/null || { echo "rsvg-convert is not installed" >&2; exit 1; }

cat > "$work/draw.mjs" <<'EOF'
import { readFileSync, writeFileSync } from 'node:fs'
import { runInNewContext } from 'node:vm'

const [keystone, outDir] = process.argv.slice(2)

function loadQmlJs(path, extra = {}) {
  const source = readFileSync(path, 'utf8')
    .split('\n')
    .map((line) => (/^\s*\.(pragma|import)\b/.test(line) ? '' : line))
    .join('\n')
  const context = { Math, JSON, isFinite, parseInt, String, Number, Array, Object, ...extra }
  runInNewContext(source, context, { filename: path })
  return context
}

const Fit = loadQmlJs(`${keystone}/BloubFit.js`)
const B = loadQmlJs(`${keystone}/Bloub.js`, { BloubFit: { offset: Fit.offset } })

const R = 100
const HALF = R * (1 + B.OVERFLOW * 2)
const r2 = (v) => Math.round(v * 100) / 100

// Omarchy's Tokyo Night, which is what most of these desktops are wearing.
const GROUND = '#1a1b26'
const DIM = '#565f89'
const TEXT = '#a9b1d6'

/** The same Catmull-Rom the Canvas renderer traces, as an SVG path. */
function bodyPath(points) {
  const n = points.length
  const tension = 1 / 6
  let d = `M${r2(points[0].x)} ${r2(points[0].y)}`
  for (let i = 0; i < n; i++) {
    const p0 = points[(i - 1 + n) % n]
    const p1 = points[i]
    const p2 = points[(i + 1) % n]
    const p3 = points[(i + 2) % n]
    d += `C${r2(p1.x + (p2.x - p0.x) * tension)} ${r2(p1.y + (p2.y - p0.y) * tension)}`
      + ` ${r2(p2.x - (p3.x - p1.x) * tension)} ${r2(p2.y - (p3.y - p1.y) * tension)}`
      + ` ${r2(p2.x)} ${r2(p2.y)}`
  }
  return `${d}Z`
}

function capsulePath(w, h) {
  const hw = Math.max(w, 0.01) / 2
  const hh = Math.max(h, 0.01) / 2
  const r = Math.min(hw, hh)
  return `M${r2(-hw)} ${r2(-hh + r)}A${r2(r)} ${r2(r)} 0 0 1 ${r2(-hw + r)} ${r2(-hh)}`
    + `L${r2(hw - r)} ${r2(-hh)}A${r2(r)} ${r2(r)} 0 0 1 ${r2(hw)} ${r2(-hh + r)}`
    + `L${r2(hw)} ${r2(hh - r)}A${r2(r)} ${r2(r)} 0 0 1 ${r2(hw - r)} ${r2(hh)}`
    + `L${r2(-hw + r)} ${r2(hh)}A${r2(r)} ${r2(r)} 0 0 1 ${r2(-hw)} ${r2(hh - r)}Z`
}

const polyline = (runs) =>
  runs.map((run) => run.map((p, i) => `${i === 0 ? 'M' : 'L'}${r2(p.x)} ${r2(p.y)}`).join('')).join('')

let uid = 0

/** One creature, drawn at the origin. Same order as Bloub.paint. */
function creature(frame, ink) {
  const id = `c${uid++}`
  const body = bodyPath(frame.bodyPts)
  const out = []
  const defs = [`<clipPath id="${id}b"><path d="${body}"/></clipPath>`]

  for (const arc of frame.arcs) {
    defs.push(`<linearGradient id="${id}${arc.id}" gradientUnits="userSpaceOnUse"`
      + ` x1="${r2(arc.grad.x1)}" y1="${r2(arc.grad.y1)}"`
      + ` x2="${r2(arc.grad.x2)}" y2="${r2(arc.grad.y2)}">`
      + arc.grad.stops.map((c, i) =>
        `<stop offset="${i / (arc.grad.stops.length - 1)}" stop-color="${c}"/>`).join('')
      + `</linearGradient>`)
  }

  const stroke = (arc, runs) => runs.length === 0 ? '' :
    `<path d="${polyline(runs)}" fill="none" stroke="url(#${id}${arc.id})"`
    + ` stroke-width="${r2(arc.width)}" stroke-linecap="round" opacity="${r2(arc.opacity)}"/>`

  for (const arc of frame.arcs) out.push(stroke(arc, arc.back))

  const dots = frame.dots.map((dot) => {
    const fill = dot.color || (dot.depth === undefined ? ink : B.mixHex(GROUND, ink, dot.depth))
    if (dot.poly) {
      const a = ((dot.rot || 0) * Math.PI) / 180
      const points = dot.poly.map((v) => {
        const x = dot.x + (v.x * Math.cos(a) - v.y * Math.sin(a)) * dot.scale
        const y = dot.y + (v.x * Math.sin(a) + v.y * Math.cos(a)) * dot.scale
        return `${r2(x)},${r2(y)}`
      })
      return `<polygon points="${points.join(' ')}" fill="${fill}" opacity="${r2(dot.opacity)}"/>`
    }
    return `<circle cx="${r2(dot.x)}" cy="${r2(dot.y)}" r="${r2(dot.r)}"`
      + ` fill="${fill}" opacity="${r2(dot.opacity)}"/>`
  })

  if (frame.dotsBehind) out.push(...dots)

  out.push(`<path d="${body}" fill="${ink}" opacity="${r2(frame.bodyAlpha)}"/>`)

  // The eyes are holes: what they show is the ground, and the body's own
  // outline is what crops them when the gaze carries them to the edge.
  const holes = frame.eyes.map((eye) =>
    `<path d="${capsulePath(eye.w, eye.h)}" fill="${GROUND}" opacity="${r2(eye.alpha)}"`
    + ` transform="matrix(${eye.m.map(r2).join(',')})"/>`)
  if (frame.notch) {
    holes.push(`<circle cx="${r2(frame.notch.x)}" cy="${r2(frame.notch.y)}"`
      + ` r="${r2(frame.notch.r)}" fill="${GROUND}"/>`)
  }
  if (holes.length) out.push(`<g clip-path="url(#${id}b)">${holes.join('')}</g>`)

  if (!frame.dotsBehind) out.push(...dots)
  if (frame.notif) {
    out.push(`<circle cx="${r2(frame.notif.x)}" cy="${r2(frame.notif.y)}"`
      + ` r="${r2(frame.notif.r)}" fill="#2496e8"/>`)
  }
  for (const arc of frame.arcs) out.push(stroke(arc, arc.front))

  return `<defs>${defs.join('')}</defs>${out.join('')}`
}

/** A tile: one creature and its caption, laid out on a grid. */
function tile(x, y, cell, caption, frame, ink) {
  const scale = (cell * 0.62) / (HALF * 2)
  return `<g transform="translate(${x + cell / 2} ${y + cell * 0.44})">`
    + `<g transform="scale(${r2(scale)})">${creature(frame, ink)}</g></g>`
    + `<text x="${x + cell / 2}" y="${y + cell * 0.88}" fill="${TEXT}"`
    + ` font-family="monospace" font-size="${r2(cell * 0.1)}" text-anchor="middle">${caption}</text>`
}

function sheet(path, columns, cell, rows) {
  const width = columns * cell
  const height = rows.length * cell
  const body = rows.map((row, r) =>
    row.map((entry, c) => tile(c * cell, r * cell, cell, entry.caption, entry.frame, entry.ink)).join('')
  ).join('')
  writeFileSync(path,
    `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}"`
    + ` viewBox="0 0 ${width} ${height}">`
    + `<rect width="${width}" height="${height}" fill="${GROUND}"/>`
    + body + `</svg>`)
}

const frameOf = (state, shape, expression, t) =>
  B.createEngine(R, state, shape, expression).sample(t)

const at = (state) => B.restingMoment(state)

/* ------------------------------------------------------------- preview.png */

// What the plugin's own moods look like, then what the customiser offers.
//
// The moment each one is caught at is not its resting moment: these states are
// animations, and the frame that reads best frozen is not always the one that
// reads best moving. `success` is the clearest case — at its own resting moment
// the body has collapsed and the particles have barely left, so a still of it
// is a dot; a third of a second later they are mid-spiral and it is legibly a
// burst.
const moods = [
  ['idle', 'resting', null],
  ['working', 'working', null],
  ['waiting', 'waiting', null],
  ['success', 'done', 0.9],
  ['error', 'error', null],
  ['sleeping', 'asleep', null],
  ['dragged', 'carried', null],
  ['tired', 'tired', null]
]
const moodRow = moods.map(([mood, caption, when]) => {
  const state = B.stateForMood(mood)
  return {
    caption,
    ink: '#ffffff',
    frame: frameOf(state, 'cercle', B.expressionForMood(mood, 'neutre'),
                   when === null ? at(state) : when)
  }
})

// One shape per palette colour, so a single row says both things at once.
const swatches = ['blanc', 'rouge', 'ambre', 'vert', 'turquoise', 'bleu', 'violet', 'rose']
const shapeRow = B.SHAPES.map((shape, i) => ({
  caption: shape.name.toLowerCase(),
  ink: B.COLOR_BY_ID[swatches[i]].hex,
  frame: frameOf('idle', shape.id, 'neutre', 1)
}))

sheet(`${outDir}/preview.svg`, 8, 150, [moodRow, shapeRow])

/* --------------------------------------------------- docs/expressions.svg */

const expressionRows = []
for (let i = 0; i < B.EXPRESSIONS.length; i += 8) {
  expressionRows.push(B.EXPRESSIONS.slice(i, i + 8).map((expression) => ({
    caption: expression.name.toLowerCase(),
    ink: '#ffffff',
    frame: frameOf('idle', 'cercle', expression.id, 1)
  })))
}
sheet(`${outDir}/expressions.svg`, 8, 150, expressionRows)

console.log('drew preview.svg and expressions.svg')
EOF

node "$work/draw.mjs" "$here/keystone" "$work"
rsvg-convert --width 1200 "$work/preview.svg" -o "$here/preview.png"
rsvg-convert --width 1200 "$work/expressions.svg" -o "$here/docs/expressions.png"
echo "wrote preview.png and docs/expressions.png"
