#!/usr/bin/env bash
# Move the QML entry point to a new directory name.
#
# The shell caches compiled QML by URL, and neither rescanPlugins nor
# reloadConfig drops it, so a changed component only reaches the desktop
# under a name it has not compiled before. That makes renaming this
# directory a routine part of shipping — and a plain search-and-replace a
# standing hazard: "chief/" also lives inside "omarchief/", and rewriting it
# once left every path to the state directory quietly wrong for weeks.
#
# So the replacement is anchored: only a name that begins a path segment is
# rewritten, never one sitting inside a longer word.
#
# Usage: tools/rename-entry <old> <new>
set -euo pipefail

if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<USAGE
Usage: tools/rename-entry <old> <new>

Move the QML entry point to a new directory name and update every
reference to it. The shell caches compiled QML by URL, so a changed
component only reaches the desktop under a name it has not compiled
before — which makes this a routine part of shipping.

The replacement is anchored to whole path segments, because "chief/" also
lives inside "omarchief/".
USAGE
  exit 0
fi
old=${1:?old directory name required}
new=${2:?new directory name required}
cd "$(dirname "$0")/.."

[[ -d $old ]] || { echo "rename-entry: no such directory: $old" >&2; exit 1; }
[[ -e $new ]] && { echo "rename-entry: $new already exists" >&2; exit 1; }

git mv "$old" "$new"

python3 - "$old" "$new" <<'PY'
import json, pathlib, re, sys

old, new = sys.argv[1], sys.argv[2]
# A path segment: preceded by nothing wordlike, so "omarchief/" is safe from
# a rename of "chief".
pattern = re.compile(r"(?<![\w.-])" + re.escape(old) + "/")

manifest = pathlib.Path("manifest.json")
data = json.loads(manifest.read_text())
data["entryPoints"] = {k: pattern.sub(new + "/", v) for k, v in data["entryPoints"].items()}
manifest.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")

touched = ["manifest.json"]
for path in list(pathlib.Path("tools").iterdir()) + list(pathlib.Path("docs").glob("*.md")) \
        + [pathlib.Path("README.md"), pathlib.Path("CHANGELOG.md")] \
        + list(pathlib.Path("tests").glob("*")):
    if not path.is_file():
        continue
    try:
        text = path.read_text()
    except (UnicodeDecodeError, OSError):
        continue
    swapped = pattern.sub(new + "/", text)
    if swapped != text:
        path.write_text(swapped)
        touched.append(str(path))

print("rename-entry: " + old + " -> " + new)
for name in touched:
    print("  " + name)
PY
