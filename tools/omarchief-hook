#!/usr/bin/env bash
# Tell the chief what the console agent is doing.
#
# Claude Code runs hooks at the seams of a session — a prompt goes in, a
# tool runs, the agent needs an answer, the turn ends — and hands each one a
# JSON event on stdin. This turns that into the one file the creature
# already watches: the OmaPets-compatible status record, so either plugin
# (or anything else) can read it.
#
# Usage: omarchief-hook <agent>        (installed by `omarchy-shell omarchief hooks on`)
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<USAGE
Usage: omarchief-hook <event> <agent>

Called by Claude Code's hooks, not by you. Maps one hook event onto the
OmaPets-compatible status file the creature reads, atomically.
USAGE
  exit 0
fi

set -euo pipefail
agent=${1:-claude}
out=${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/omapets/status.json

event=$(python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print(d.get("hook_event_name",""))' 2>/dev/null || true)

case "$event" in
  UserPromptSubmit|PreToolUse|PostToolUse) state=working ;;
  Notification)                            state=waiting ;;   # a permission prompt, or waiting on you
  Stop)                                    state=success ;;
  SessionStart|SessionEnd)                 state=idle ;;
  *)                                       exit 0 ;;
esac

mkdir -p "$(dirname "$out")"
tmp=$(mktemp "$(dirname "$out")/.status.XXXXXX")
printf '{"agent":"%s","state":"%s","updatedAtEpoch":%d}\n' "$agent" "$state" "$(date +%s)" > "$tmp"
mv -f "$tmp" "$out"
