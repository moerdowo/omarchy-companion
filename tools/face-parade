#!/usr/bin/env bash
# Show every face the pet has, driven for real.
#
# The mood is not something you can set: it is worked out from the agent's
# hooks and how much of its rate limit is left. So this writes those two
# files — the same ones the agent and OmaPets write — waits for the creature
# to notice, and photographs it. What comes out is a contact sheet of the
# pet's whole emotional range, taken off the screen rather than off the sheet.
#
# Both files are put back exactly as they were found.
#
# Usage: tools/face-parade [out.png]
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
  cat <<USAGE
Usage: tools/face-parade [out.png]

Drive the creature through every mood it can wear and photograph it off
the screen, into a contact sheet. Writes /tmp/omarchief-faces.png unless
told otherwise, and puts the files it touched back as it found them.
USAGE
  exit 0
fi

set -euo pipefail
out=${1:-/tmp/omarchief-faces.png}
command -v grim >/dev/null || { echo "face-parade: needs grim" >&2; exit 1; }

python3 - "$out" <<'PY'
import json, os, subprocess, sys, tempfile, time

out = sys.argv[1]
state = os.path.expanduser("~/.local/state/omarchy/omarchief")
hookfile = os.path.expanduser("~/.local/state/omarchy/omapets/status.json")
# The agent the creature answers with, which is not always the desktop's:
# a hook record naming anyone else is correctly ignored, and writing the
# wrong name here made every mood but the first quietly fail to take.
def whose_agent():
    try:
        with open(os.path.expanduser("~/.local/state/omarchy/omarchief/status.json")) as f:
            named = str(json.load(f).get("agent") or "").strip()
            if named and named != "none":
                return named
    except Exception:
        pass
    return open(os.path.expanduser("~/.config/omarchy/defaults/agent")).read().strip()

agent = whose_agent()
usage = os.path.expanduser(f"~/.local/state/omarchy/agents/usage/{agent}.json")
cfg = json.load(open(os.path.expanduser("~/.config/omarchy/omarchief.json")))
size = int(cfg.get("size") or 56)

def status():
    return json.load(open(f"{state}/status.json"))

def restore_of(path):
    return open(path).read() if os.path.exists(path) else None

hook_before, usage_before = restore_of(hookfile), restore_of(usage)

def write_atomic(path, text):
    """A watcher that is mid-read when the file is rewritten in place sees
    half a file, or nothing at all. Renaming over it is one step."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)

def set_hook(name):
    write_atomic(hookfile, json.dumps({"agent": agent, "state": name, "updatedAtEpoch": int(time.time())}))

def clear_hook():
    if os.path.exists(hookfile): os.remove(hookfile)

def set_energy(fraction):
    """Rate limit left, as the agent's own usage file reports it."""
    rec = json.loads(usage_before) if usage_before else {"schemaVersion": 1, "id": agent}
    rec["limits"] = [{"percent": round(1.0 - fraction, 4)}]
    write_atomic(usage, json.dumps(rec))

def shot(label, shots):
    st = status()
    with tempfile.NamedTemporaryFile(suffix=".png", delete=False) as f:
        subprocess.run(["grim", "-o", st["monitor"], f.name], check=True)
        shots.append((label, st["mood"], f.name))
    return st["mood"]

# mood, and what to do to get there
script = [
    ("idle",     lambda: (clear_hook(), set_energy(1.0))),
    ("working",  lambda: set_hook("working")),
    ("waiting",  lambda: set_hook("waiting")),
    ("success",  lambda: set_hook("success")),
    ("error",    lambda: set_hook("error")),
    ("tired",    lambda: (clear_hook(), set_energy(0.2))),
    ("sleeping", lambda: (clear_hook(), set_energy(0.0))),
]

def settle(want, seconds=8.0):
    """Wait for the creature to notice. A file watcher, a reload and a
    re-evaluation take a moment, and how long is not ours to guess — so ask
    until the answer arrives rather than sleeping a fixed spell and hoping."""
    deadline = time.time() + seconds
    while time.time() < deadline:
        if status()["mood"] == want: return True
        time.sleep(0.15)
    return False

shots = []
print(f"  {'asked for':10} {'mood became':12}")
try:
    for want, drive in script:
        drive()
        settle(want)
        got = shot(want, shots)
        print(f"  {want:10} {got:12} {'ok' if got == want else 'DID NOT TAKE'}")
finally:
    if hook_before is not None: open(hookfile, "w").write(hook_before)
    elif os.path.exists(hookfile): os.remove(hookfile)
    if usage_before is not None: open(usage, "w").write(usage_before)
    time.sleep(1.5)

# Crop each shot to the creature and lay them out with their labels.
tiles = []
work = tempfile.mkdtemp()
w = int(size * 1.5)
for label, mood, path in shots:
    h = subprocess.run(["magick", "identify", "-format", "%h", path], capture_output=True, text=True).stdout
    tile = f"{work}/{label}.png"
    subprocess.run(["magick", path, "-crop", f"{w}x{int(size*1.3)}+0+{int(h) - int(size*1.3)}", "+repage",
                    "-background", "#12141a", "-flatten",
                    "-gravity", "South", "-splice", "0x26",
                    "-pointsize", "17", "-fill", "#c9cdd3", "-annotate", "+0+5", label,
                    tile], check=True)
    tiles.append(tile)
subprocess.run(["magick", "montage", *tiles, "-tile", f"{len(tiles)}x1", "-geometry", "+4+4",
                "-background", "#12141a", out], check=True)
print(f"  → {out}")
PY
